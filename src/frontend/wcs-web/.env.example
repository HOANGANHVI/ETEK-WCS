# Copy to .env.local (ignored by Git). Values are examples only.
# Base URL of the WCS API. Leave empty in development to use the Vite proxy.
VITE_API_BASE_URL=
# Target of the Vite dev proxy (/api and /hubs).
VITE_DEV_API_TARGET=http://localhost:5007
# Demo Mode: in-browser fake data, no backend/PostgreSQL needed (see README). Keep false for real operation.
VITE_DEMO_MODE=false
# Optional: factory / area name shown in the header (leave empty to hide it).
VITE_SITE_NAME=

# Engineering tools (simulator controls, PLC test-write) are shown to Admin only in `npm run dev` builds.
# A production build never shows them unless this is explicitly set to true (do not set it in production).
VITE_ENABLE_ENGINEERING_TOOLS=false
