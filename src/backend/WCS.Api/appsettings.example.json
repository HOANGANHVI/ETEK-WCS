{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WcsDatabase": "Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<set-via-user-secrets-or-env>"
  },
  "Plc": {
    "Enabled": false,
    "Model": "<to-be-confirmed>",
    "Host": "<to-be-confirmed>",
    "Port": 0,
    "PollingIntervalMs": 0,
    "ConnectionTimeoutMs": 0,
    "RetryIntervalMs": 0
  },
  "Rcs": {
    "Enabled": false,
    "BaseUrl": "<to-be-confirmed>",
    "CallbackUrl": "<to-be-confirmed>",
    "RequestTimeoutMs": 0,
    "ApiKey": "<set-via-user-secrets-or-env>"
  }
}
