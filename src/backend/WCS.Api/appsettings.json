{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "ThrottleSeconds": 60,
    "SystemLog": { "Enabled": true, "RetentionDays": 90 }
  },
  "AllowedHosts": "*",
  "Integration": {
    "Mode": "Simulator",
    "AllowNetworkProbe": false
  },
  "Scheduler": {
    "TickIntervalMs": 1000,
    "MaxDispatchAttempts": 5,
    "StateTimeoutsSeconds": {}
  },
  "ProcessFlows": {
    "NoSourceBehavior": "Fail",
    "Flows": {
      "Bp01": {
        "RackKind": "Full",
        "AllowedRequestStations": [ "A1", "A2" ],
        "SourceMode": "Request",
        "DestinationMode": "Search",
        "DestinationGroups": [ [ "B1", "B2" ], [ "F1", "F2" ], [ "F5" ] ],
        "NoBindDropLocations": [ "B1", "B2" ]
      },
      "Bp02": {
        "RackKind": "Empty",
        "AllowedRequestStations": [ "A1", "A2" ],
        "SourceMode": "Search",
        "SourceGroups": [ [ "B1", "B2" ], [ "F3", "F4" ] ],
        "DestinationMode": "Request",
        "NoBindDropLocations": []
      },
      "Bp03": {
        "RackKind": "Empty",
        "AllowedRequestStations": [ "B1", "B2" ],
        "SourceMode": "Request",
        "DestinationMode": "Search",
        "DestinationGroups": [ [ "A1", "A2" ], [ "F3", "F4" ] ],
        "NoBindDropLocations": [ "A1", "A2" ]
      },
      "Bp05": {
        "RackKind": "Full",
        "AllowedRequestStations": [ "F5" ],
        "SourceMode": "Search",
        "SourceGroups": [ [ "F1", "F2" ] ],
        "DestinationMode": "Request",
        "NoBindDropLocations": []
      },
      "Bp06": {
        "RackKind": "Empty",
        "AllowedRequestStations": [ "F5" ],
        "SourceMode": "Request",
        "DestinationMode": "Search",
        "DestinationGroups": [ [ "A1", "A2" ], [ "F3", "F4" ] ],
        "NoBindDropLocations": [ "A1", "A2" ]
      }
    }
  },
  "Seed": { "Enabled": false },
  "ResourceMonitoring": {
    "Enabled": true,
    "SampleIntervalSeconds": 5,
    "HistoryMinutes": 10,
    "CpuWarning": 80, "CpuCritical": 95,
    "MemoryWarning": 80, "MemoryCritical": 95,
    "DiskWarning": 80, "DiskCritical": 90
  }
}
