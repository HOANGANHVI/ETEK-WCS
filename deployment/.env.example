# ETEK WCS - production settings TEMPLATE.
# Copy this file to  C:\ETEK-WCS\config\.env  (outside the repository) and edit it there.
# The real .env is never committed and is not touched by git pull. Do not put real values in this example file.
# Values must be written WITHOUT trailing comments on the same line.

# ---- Database (PostgreSQL 16, internal to Docker; not published to the LAN)
POSTGRES_DB=wcs_db
POSTGRES_USER=wcs
# REQUIRED: long random value. Changing it later does NOT change the password inside an existing database.
POSTGRES_PASSWORD=

# ---- First administrator (used only while no account exists; Production never creates admin/admin)
WCS_ADMIN_USERNAME=admin
# REQUIRED for the first start. The administrator must change it at first sign-in.
WCS_ADMIN_BOOTSTRAP_PASSWORD=

# ---- Web access (only Nginx is published)
WCS_HTTP_PORT=80
# Always = HTTPS only (default). RECOMMENDED for operation: HTTPS + Always.
# SameAsRequest = plain HTTP, ONLY for a trusted TEST LAN (login works over http://<ip>); the session cookie then travels unencrypted. Never for operation or the Internet.
WCS_COOKIE_SECURE=Always

# ---- Internal Docker network (change only if 172.30.0.0/24 clashes with your LAN). Nginx gets a fixed address; the backend trusts
# X-Forwarded-For/Proto ONLY from that address. WCS_NGINX_IP must be inside WCS_EDGE_SUBNET.
WCS_EDGE_SUBNET=172.30.0.0/24
WCS_NGINX_IP=172.30.0.10

# ---- PLC safety: the defaults keep every PLC path closed
# PLC_ALLOW_LIVE_CONNECTION=false: no socket to any physical PLC (and no simulator). PLC_MODE=RealReadWrite is the supported mode (CR-015) and does NOT write by itself:
# the runtime becomes REAL_READ_WRITE only when BOTH PLC_ALLOW_LIVE_CONNECTION=true and PLC_WRITE_ENABLED=true are set (CR-019: the engineer approval reference and the handshake approval keys
# no longer exist; old lines for them in an existing .env are ignored). With either missing it stays read-only (the IO mapping page names what is missing). Do NOT set PLC_MODE=RealReadOnly here unless you want writing to be impossible.
PLC_MODE=RealReadWrite
PLC_ALLOW_LIVE_CONNECTION=false
# Write key (CR-015/CR-019): leave it false until writing is intended. Each write also needs the Admin's write approval of that IO point in the UI. After editing this file run deploy.ps1 (or start.ps1) so the backend container is recreated; check with deployment\scripts\plc-write-config.ps1.
PLC_WRITE_ENABLED=false
# Production refuses Plc:Mode=Simulator unless this is true. Only for a deliberate, supervised start without PLC. Never in operation.
PLC_ALLOW_SIMULATOR_IN_PRODUCTION=false
# PLC IPs (192.168.10.101/111/121/131), ports and MC parameters are entered by an Admin in the UI after the PLC engineer confirms them
# (stored in the database and kept across updates). REAL_READ_WRITE cannot be enabled from this file.

# ---- RCS (CR-027 / CR-028). Defaults keep today's behaviour.
# RCS_FLEET_SOURCE=Real (default in operation, CR-031): WCS sends ONE read-only queryAgvStatus per interval to the RCS that an Admin saved in the UI (Kết nối RCS: host, port; no username/password/token is used for this call); Production REFUSES to start with Simulator unless Rcs__Fleet__AllowSimulatorInProduction=true;
# it sends no task command. The RCS host is NOT set here. Real task dispatch (genAgvSchedulingTask) is NOT implemented: Integration__Mode stays Simulator.
RCS_FLEET_SOURCE=Real
RCS_FLEET_INTERVAL_SECONDS=5
# RCS_DISPATCH_MODE=Legacy (default). RcsManaged is for the RCS simulator only (no real adapter): never set it in operation. WCS refuses to start in a mode while the other mode still has active tasks.
RCS_DISPATCH_MODE=Legacy

# ---- Other
# true allows the TCP reachability test of the connection test (opens a TCP port only, sends no PLC command).
WCS_ALLOW_NETWORK_PROBE=false
WCS_LOG_LEVEL=Information
# Deployment log folder (scripts write here; the backend mounts it read-only). Normally leave unset: default C:/ETEK-WCS/logs. Never put secrets here.
# WCS_LOG_DIR=C:/ETEK-WCS/logs
# CR-026: configuration export/import for administrators is ON by default (nothing to set). Uncomment only as an emergency switch. Its folder is the persistent volume etek_wcs_config_backups.
# WCS_CONFIG_TRANSFER_ENABLED=true
WCS_TIMEZONE=Asia/Ho_Chi_Minh
# Image tag label; deploy.ps1 sets it to the git commit when left as local.
WCS_VERSION=local

# ---- Resource limits (starting values for 8 cores / 16 GB; adjust to the machine)
WCS_DB_CPUS=2
WCS_DB_MEMORY=2g
WCS_BACKEND_CPUS=3
WCS_BACKEND_MEMORY=3g
