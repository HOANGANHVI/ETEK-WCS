# ETEK WCS - production settings TEMPLATE.
# Copy this file to  C:\ETEK-WCS\config\.env  (outside the repository) and edit it there.
# The real .env is never committed and is not touched by git pull. Do not put real values in this example file.
# Values must be written WITHOUT trailing comments on the same line.

# ---- Database (PostgreSQL 16, internal to Docker; not published to the LAN)
POSTGRES_DB=wcs_db
POSTGRES_USER=wcs
# REQUIRED: long random value. Changing it later does NOT change the password inside an existing database.
POSTGRES_PASSWORD=

# ---- First administrator (used only while no account exists; Production never creates admin/admin)
WCS_ADMIN_USERNAME=admin
# REQUIRED for the first start. The administrator must change it at first sign-in.
WCS_ADMIN_BOOTSTRAP_PASSWORD=

# ---- Web access (only Nginx is published)
WCS_HTTP_PORT=80
# Always = HTTPS only (default, most secure).
# SameAsRequest = plain HTTP on a trusted test LAN (login works over http://<ip>). Never use it over the Internet.
WCS_COOKIE_SECURE=Always

# ---- PLC safety: the defaults keep every PLC path closed
# RealReadOnly + PLC_ALLOW_LIVE_CONNECTION=false: no simulator and no socket to any physical PLC.
PLC_MODE=RealReadOnly
PLC_ALLOW_LIVE_CONNECTION=false
# Production refuses Plc:Mode=Simulator unless this is true. Only for a deliberate, supervised start without PLC. Never in operation.
PLC_ALLOW_SIMULATOR_IN_PRODUCTION=false
# PLC IPs (192.168.10.101/111/121/131), ports and MC parameters are entered by an Admin in the UI after the PLC engineer confirms them
# (stored in the database and kept across updates). REAL_READ_WRITE cannot be enabled from this file.

# ---- Other
# true allows the TCP reachability test of the connection test (opens a TCP port only, sends no PLC command).
WCS_ALLOW_NETWORK_PROBE=false
WCS_LOG_LEVEL=Information
WCS_TIMEZONE=Asia/Ho_Chi_Minh
# Image tag label; deploy.ps1 sets it to the git commit when left as local.
WCS_VERSION=local

# ---- Resource limits (starting values for 8 cores / 16 GB; adjust to the machine)
WCS_DB_CPUS=2
WCS_DB_MEMORY=2g
WCS_BACKEND_CPUS=3
WCS_BACKEND_MEMORY=3g
