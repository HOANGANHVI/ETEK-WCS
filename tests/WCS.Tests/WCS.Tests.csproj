<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Same id as WCS.Api so 'dotnet user-secrets set "Database:Password" ...' (run in WCS.Api) also serves the tests. -->
    <UserSecretsId>a60f32ab-562a-416e-b6e8-35d8c59525b9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\WCS.Domain\WCS.Domain.csproj" />
    <ProjectReference Include="..\..\src\backend\WCS.Application\WCS.Application.csproj" />
    <ProjectReference Include="..\..\src\backend\WCS.Infrastructure\WCS.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\WCS.Runtime\WCS.Runtime.csproj" />
    <ProjectReference Include="..\..\src\backend\WCS.Api\WCS.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\backend\WCS.Api\appsettings.json" Link="api.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\backend\WCS.Api\appsettings.Development.json" Link="api.appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
